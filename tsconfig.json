{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node",
      "jest"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    //"noUnusedLocals": true, // ja tem no eslint
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "moduleDetection": "force", // Deixa um export implicit nos arquivos que não tiver nenhum export
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
